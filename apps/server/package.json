{
  "name": "@codex-web/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "codex-web": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "auth:reset": "node dist/cli.js auth reset",
    "sync:doctor": "node dist/cli.js sync doctor",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@codex-web/api": "workspace:*",
    "@codex-web/config": "workspace:*",
    "@codex-web/domain": "workspace:*",
    "@codex-web/protocol": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^8.2.0",
    "@fastify/websocket": "^11.2.0",
    "better-sqlite3": "^12.10.0",
    "drizzle-orm": "^0.44.5",
    "fastify": "^5.5.0",
    "mammoth": "^1.12.0",
    "xlsx": "^0.18.5",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "vitest": "^3.2.4"
  }
}
