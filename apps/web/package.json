    "@tanstack/react-virtual": "^3.13.26",
    "@vitejs/plugin-react": "^5.0.2",
    "i18next": "^26.3.0",
    "lucide-react": "^0.542.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^17.0.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "vite": "^7.1.4"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
